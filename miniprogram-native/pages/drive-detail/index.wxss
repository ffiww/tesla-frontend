.detail-summary { padding-bottom:22rpx; }
.detail-date { font-size:34rpx; font-weight:750; margin:12rpx 0 20rpx; }
.endpoint { display:flex; align-items:center; gap:12rpx; color:#777c84; font-size:22rpx; margin:9rpx 0; }
.start-dot,.end-dot { width:14rpx; height:14rpx; border-radius:50%; background:#42a878; }
.end-dot { background:#e65e61; }
.summary-line { color:#858a92; font-size:21rpx; margin:18rpx 0; }
.metric-pills { display:flex; flex-wrap:wrap; gap:10rpx; }
.metric-pills text { padding:12rpx 17rpx; background:#f5f6f7; border-radius:999rpx; color:#4d535a; font-size:19rpx; }
.card-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:18rpx; }
.card-heading .section-title { font-size:27rpx; }
.card-heading .muted { font-size:19rpx; }
.route-map { width:100%; height:560rpx; border-radius:16rpx; overflow:hidden; }
.map-empty { min-height:300rpx; }
.speed-legend { display:flex; align-items:center; gap:14rpx; margin-top:16rpx; color:#727780; font-size:20rpx; }
.speed-gradient { flex:1; height:14rpx; border-radius:99rpx; background:linear-gradient(90deg,#cc8587,#c9ad78,#7da88d); }
.speed-legend-caption { display:flex; justify-content:space-between; color:#969ba2; font-size:18rpx; margin-top:8rpx; }
.trend-canvas { display:block; width:100%; height:380rpx; }
.legend { display:flex; justify-content:center; gap:24rpx; padding-top:8rpx; color:#7b8088; font-size:20rpx; }
.legend text { display:flex; align-items:center; }
.legend-mark { display:inline-block; width:20rpx; height:7rpx; background:#e82127; border-radius:5rpx; margin-right:8rpx; }
.legend-mark.soc,.legend-mark.longitudinal { background:#418cc8; }
.legend-mark.lateral { background:#e39a48; }
.chart-note { display:block; color:#8d9299; font-size:20rpx; text-align:center; padding-bottom:10rpx; }
